datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RuleStatus {
  DISCOVERED
  IN_REVIEW
  VALIDATED
  APPROVED
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum CitationTier {
  TIER_1_OFFICIAL
  TIER_2_GOV_DEPT
  TIER_3_THIRD_PARTY
}

enum RuleType {
  FLAT_RATE
  BRACKET_PERCENTAGE
  STANDARD_ALLOWANCE
  THRESHOLD
  EXEMPTION
  PER_MILE_RATE
}

enum PayFrequency {
  WEEKLY
  BI_WEEKLY
  SEMI_MONTHLY
  MONTHLY
}

enum WeekendRollRule {
  PREVIOUS_BUSINESS_DAY
  NEXT_BUSINESS_DAY
  EXACT_DAY
}

enum CalendarPeriodStatus {
  DRAFT
  PUBLISHED
  OPEN
  LOCKED
  COMPLETED
}

enum BankReconciliationStatus {
  UNMATCHED
  NEEDS_REVIEW
  MATCHED
  DUPLICATE
}

enum BankMatchedEntityType {
  GENERAL_EXPENSE
  TRAVEL_EXPENSE
  INVOICE
  PAYROLL_RUN
  CONTRACTOR_PAYMENT
  TRANSFER_INTERNAL
}

model Company {
  id                  String            @id @default(uuid())
  name                String
  ein                 String
  stateTaxId          String            @map("stateTaxId")
  address             String
  city                String
  state               String
  zip                 String
  ownerName           String            @map("ownerName")
  ownerEmail          String            @map("ownerEmail")
  ownerTaxBracket     Float?            @map("ownerTaxBracket")
  stateFilingFrequency String           @default("MONTHLY") @map("stateFilingFrequency")
  payFrequency         String?          @default("BI_WEEKLY") @map("payFrequency")
  standardMileageRate Float?            @map("standardMileageRate")
  bankName            String?           @map("bankName")
  routingNumber       String?           @map("routingNumber")
  accountNumber       String?           @map("accountNumber")
  mercuryApiKey       String?           @map("mercuryApiKey")
  mercuryAccountId    String?           @map("mercuryAccountId")
  status              String            @default("ACTIVE")
  closedAt            DateTime?         @map("closed_at")
  closureReason       String?           @map("closure_reason")
  createdAt           DateTime          @default(now()) @map("createdAt")
  updatedAt           DateTime          @updatedAt @map("updatedAt")

  addressHistory    CompanyAddressHistory[]
  taxYears          TaxYear[]
  employees         Employee[]
  mileageLogs       MileageLog[]
  travelExpenses    TravelExpense[]
  generalExpenses   GeneralExpense[]
  payrollRuns       PayrollRun[]
  complianceTasks   ComplianceTask[]
  auditLogs         AuditLogEntry[]
  payScheduleConfigs PayScheduleConfig[]
  calendarPeriods   PayrollCalendarPeriod[]
  capitalAssets     CapitalAsset[]
  homeOfficeExpenses HomeOfficeExpense[]
  customers         Customer[]
  invoices          Invoice[]
  formW9Records     FormW9Record[]
  contractorPayments ContractorPayment[]
  bankImportBatches  BankImportBatch[]
  bankTransactions   BankTransaction[]

  @@map("companies")
}

model CompanyAddressHistory {
  id                   String    @id @default(uuid())
  companyId            String    @map("company_id")
  streetAddress        String    @map("street_address")
  city                 String
  state                String
  zip                  String
  psdCode              String?   @map("psd_code")
  localJurisdictionName String?  @map("local_jurisdiction_name")
  workEitRate          Float?    @map("work_eit_rate")
  effectiveDate        String    @map("effective_date")
  endDate              String?   @map("end_date")
  createdAt            DateTime  @default(now()) @map("created_at")

  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_address_histories")
}

model TaxYear {
  id        String   @id @default(uuid())
  companyId String
  year      Int
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  calendarPeriods PayrollCalendarPeriod[]
  homeOfficeExpenses HomeOfficeExpense[]
  invoices        Invoice[]
  contractorPayments ContractorPayment[]

  @@unique([companyId, year])
  @@map("tax_years")
}

model TaxJurisdiction {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  level     String
  state     String?
  createdAt DateTime  @default(now())

  rules     TaxRule[]

  @@map("tax_jurisdictions")
}

model TaxRule {
  id             String           @id @default(uuid())
  jurisdictionId String
  ruleCode       String
  name           String
  description    String?
  category       String
  createdAt      DateTime         @default(now())

  jurisdiction   TaxJurisdiction  @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  versions       TaxRuleVersion[]

  @@unique([jurisdictionId, ruleCode])
  @@map("tax_rules")
}

model TaxRuleVersion {
  id               String       @id @default(uuid())
  ruleId           String
  versionNumber    Int
  status           RuleStatus   @default(IN_REVIEW)
  ruleType         RuleType
  ruleData         Json
  sourceTitle      String
  sourceUrl        String
  sourcePublisher  String
  statuteReference String
  citationTier     CitationTier
  effectiveStart   DateTime
  effectiveEnd     DateTime?
  createdAt        DateTime     @default(now())
  activatedAt      DateTime?
  activatedBy      String?

  rule             TaxRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@map("tax_rule_versions")
}

model CalculationSnapshot {
  id              String   @id @default(uuid())
  calculationType String
  entityId        String
  ruleVersionIds  Json
  snapshotData    Json
  createdAt       DateTime @default(now())

  @@map("calculation_snapshots")
}

model AuditLogEntry {
  id            String   @id @default(uuid())
  companyId     String   @map("companyId")
  entityType    String   @map("entityType")
  entityId      String   @map("entityId")
  action        String
  actorId       String   @map("actorId")
  previousState Json?    @map("previousState")
  newState      Json?    @map("newState")
  reason        String?
  timestamp     DateTime @default(now())

  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("audit_log_entries")
}

model Employee {
  id                  String          @id @default(uuid())
  companyId           String?         @map("company_id")
  firstName           String          @map("first_name")
  lastName            String          @map("last_name")
  age                 Int?
  relationshipToOwner String          @default("NONE") @map("relationship_to_owner")
  email               String
  phone               String
  ssnLastFour         String          @map("ssn_last_four")
  streetAddress       String?         @map("street_address")
  city                String?
  state               String?
  zip                 String?
  employmentType      String          @map("employment_type")
  payRate             Float           @map("pay_rate")
  payFrequency        String          @map("pay_frequency")
  w4FilingStatus      String          @map("w4_filing_status")
  w4MultipleJobs      Boolean         @default(false) @map("w4_multiple_jobs")
  w4DependentCredit   Float           @default(0) @map("w4_dependent_credit")
  w4OtherIncome       Float           @default(0) @map("w4_other_income")
  w4Deductions        Float           @default(0) @map("w4_deductions")
  w4ExtraWithholding  Float           @default(0) @map("w4_extra_withholding")
  workState           String?         @map("work_state")
  stateW4FilingStatus String?         @map("state_w4_filing_status")
  stateAllowances     Int             @default(0) @map("state_allowances")
  localTaxJurisdictionCode String?     @map("local_tax_jurisdiction_code")
  localTaxJurisdictionName String?     @map("local_tax_jurisdiction_name")
  // Legacy tax values are retained only for migration/audit visibility. Runtime
  // calculations must resolve statutory values from TaxRuleVersion instead.
  localTaxRate        Float?          @map("local_tax_rate")
  localFlatTaxAnnual  Float?          @map("local_flat_tax_annual")
  localFlatTaxExempt  Boolean         @default(false) @map("local_flat_tax_exempt")
  taxAttributes       Json?           @map("tax_attributes")
  bankName            String?         @map("bank_name")
  accountType         String          @default("CHECKING") @map("account_type")
  routingNumber       String?         @map("routing_number")
  accountNumber       String?         @map("account_number")
  bankAccountMasked   String?         @map("bank_account_masked")
  isActive            Boolean         @default(true) @map("is_active")
  workerClassification String       @default("W2_EMPLOYEE") @map("worker_classification")
  createdAt           DateTime        @default(now()) @map("created_at")

  company             Company?                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  residenceHistory    EmployeeResidenceHistory[]
  workLocationHistory EmployeeWorkLocationHistory[]
  bankHistory         EmployeeBankHistory[]
  mileageLogs         MileageLog[]
  travelExpenses      TravelExpense[]
  payStubs            PayStub[]
  timesheets          Timesheet[]
  w9Record            FormW9Record?
  contractorPayments  ContractorPayment[]

  @@map("employees")
}

model EmployeeBankHistory {
  id                String    @id @default(uuid())
  employeeId        String    @map("employee_id")
  bankName          String    @map("bank_name")
  accountType       String    @default("CHECKING") @map("account_type")
  routingNumber     String    @map("routing_number")
  accountNumber     String    @map("account_number")
  bankAccountMasked String    @map("bank_account_masked")
  effectiveDate     String    @map("effective_date")
  endDate           String?   @map("end_date")
  createdAt         DateTime  @default(now()) @map("created_at")

  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_bank_histories")
}

model EmployeeResidenceHistory {
  id                   String    @id @default(uuid())
  employeeId           String    @map("employee_id")
  streetAddress        String    @map("street_address")
  city                 String
  state                String
  zip                  String
  psdCode              String?   @map("psd_code")
  localJurisdictionName String?  @map("local_jurisdiction_name")
  localTaxRate         Float?    @map("local_tax_rate")
  effectiveDate        String    @map("effective_date")
  endDate              String?   @map("end_date")
  createdAt            DateTime  @default(now()) @map("created_at")

  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_residence_histories")
}

model MileageLog {
  id                            String   @id @default(uuid())
  companyId                     String?  @map("company_id")
  employeeId                    String   @map("employee_id")
  tripDate                      String   @map("trip_date")
  originLocation                String   @map("origin_location")
  destinationLocation           String   @map("destination_location")
  businessPurpose               String   @map("business_purpose")
  startOdometer                 Float    @map("start_odometer")
  endOdometer                   Float    @map("end_odometer")
  calculatedMiles               Float    @map("calculated_miles")
  rateApplied                   Float    @map("rate_applied")
  mileageAllowance              Float    @map("mileage_allowance")
  isReimbursableAccountablePlan Boolean  @default(true) @map("is_reimbursable_accountable_plan")
  status                        String
  linkedPayStubId               String?  @map("linked_pay_stub_id")
  notes                         String?
  createdAt                     DateTime @default(now()) @map("created_at")

  company                       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee                      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("mileage_logs")
}

model TravelExpense {
  id              String   @id @default(uuid())
  companyId       String?  @map("company_id")
  employeeId      String   @map("employee_id")
  mileageLogId    String?  @map("mileage_log_id")
  expenseDate     String   @map("expense_date")
  category        String
  description     String
  amount          Float
  paymentSource   String   @map("payment_source")
  receiptNote     String?  @map("receipt_note")
  receiptUrl      String?  @map("receipt_url")
  isReimbursable  Boolean  @default(true) @map("is_reimbursable")
  status          String
  linkedPayStubId String?  @map("linked_pay_stub_id")
  createdAt       DateTime @default(now()) @map("created_at")

  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("travel_expenses")
}

model GeneralExpense {
  id              String   @id @default(uuid())
  companyId       String?  @map("company_id")
  expenseDate     String   @map("expense_date")
  category        String
  payee           String
  description     String
  amount          Float
  scheduleCLine   String?  @map("schedule_c_line")
  isTaxDeductible Boolean  @default(true) @map("is_tax_deductible")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractorPayment ContractorPayment?

  @@map("general_expenses")
}

model PayrollRun {
  id                  String    @id @default(uuid())
  companyId           String?   @map("company_id")
  periodStart         String    @map("period_start")
  periodEnd           String    @map("period_end")
  payDate             String    @map("pay_date")
  status              String
  totalGross          Float     @map("total_gross")
  totalEmployeeTaxes  Float     @map("total_employee_taxes")
  totalReimbursements Float     @map("total_reimbursements")
  totalNetPay         Float     @map("total_net_pay")
  totalEmployerTaxes  Float     @map("total_employer_taxes")
  totalCompanyCost    Float     @map("total_company_cost")
  stubsCount          Int       @map("stubs_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  lockedAt            DateTime? @map("locked_at")

  company             Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payStubs            PayStub[]

  @@map("payroll_runs")
}

model PayStub {
  id                          String     @id @default(uuid())
  payrollRunId                String     @map("payroll_run_id")
  employeeId                  String     @map("employee_id")
  periodStart                 String     @map("period_start")
  periodEnd                   String     @map("period_end")
  payDate                     String     @map("pay_date")
  hoursWorked                 Float      @map("hours_worked")
  overtimeHours               Float      @map("overtime_hours")
  hourlyRate                  Float      @map("hourly_rate")
  grossEarnings               Float      @map("gross_earnings")
  federalIncomeTax            Float      @map("federal_income_tax")
  socialSecurityTax           Float      @map("social_security_tax")
  medicareTax                 Float      @map("medicare_tax")
  stateCode                   String     @default("PA") @map("state_code")
  localityCode                String?    @map("locality_code")
  localityName                String?    @map("locality_name")
  stateIncomeTax              Float      @default(0) @map("state_income_tax")
  localIncomeTax              Float      @default(0) @map("local_income_tax")
  localFlatTax                Float      @default(0) @map("local_flat_tax")
  totalEmployeeTaxes          Float      @map("total_employee_taxes")
  mileageReimbursement        Float      @map("mileage_reimbursement")
  travelExpensesReimbursement Float      @map("travel_expenses_reimbursement")
  totalReimbursements         Float      @map("total_reimbursements")
  netPay                      Float      @map("net_pay")
  employerSocialSecurity      Float      @map("employer_social_security")
  employerMedicare            Float      @map("employer_medicare")
  employerStateUnemployment   Float      @default(0) @map("employer_state_unemployment")
  taxBreakdown                Json?      @map("tax_breakdown")
  totalEmployerTaxes          Float      @map("total_employer_taxes")
  totalCompanyCost            Float      @map("total_company_cost")
  disbursementMethod          String     @map("disbursement_method")
  disbursementStatus          String     @map("disbursement_status")
  achTraceRef                 String?    @map("ach_trace_ref")
  paidAt                      DateTime?  @map("paid_at")
  createdAt                   DateTime   @default(now()) @map("created_at")

  payrollRun                  PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee                    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taxLines                    PayStubTaxLine[]

  @@map("pay_stubs")
}

model PayStubTaxLine {
  id               String   @id @default(uuid())
  payStubId        String   @map("pay_stub_id")
  jurisdictionType String   @map("jurisdiction_type")
  jurisdictionCode String   @map("jurisdiction_code")
  jurisdictionName String   @map("jurisdiction_name")
  taxableWages     Float    @map("taxable_wages")
  taxRate          Float    @map("tax_rate")
  taxWithheld      Float    @map("tax_withheld")
  startDate        String?  @map("start_date")
  endDate          String?  @map("end_date")
  createdAt        DateTime @default(now()) @map("created_at")

  payStub          PayStub  @relation(fields: [payStubId], references: [id], onDelete: Cascade)

  @@map("pay_stub_tax_lines")
}

model ComplianceTask {
  id                 String    @id @default(uuid())
  companyId          String?   @map("company_id")
  jurisdiction       String
  formIdentifier     String    @map("form_identifier")
  title              String
  taxPeriodLabel     String    @map("tax_period_label")
  dueDate            String    @map("due_date")
  filingMethod       String?   @map("filing_method")
  portalUrl          String?   @map("portal_url")
  status             String
  amountDue          Float     @map("amount_due")
  boxValues          Json      @map("box_values")
  confirmationNumber String?   @map("confirmation_number")
  filedDate          String?   @map("filed_date")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("compliance_tasks")
}

model Timesheet {
  id                 String   @id @default(uuid())
  employeeId         String   @map("employee_id")
  periodId           String?  @map("period_id")
  workDate           String   @map("work_date")
  startTime          String   @map("start_time")
  endTime            String   @map("end_time")
  unpaidBreakMinutes Int      @default(0) @map("unpaid_break_minutes")
  regularHours       Float    @map("regular_hours")
  overtimeHours      Float    @map("overtime_hours")
  notes              String?
  status             String
  linkedPayStubId    String?  @map("linked_pay_stub_id")
  createdAt          DateTime @default(now()) @map("created_at")

  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  calendarPeriod     PayrollCalendarPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@map("timesheets")
}

model PayScheduleConfig {
  id                  String          @id @default(uuid())
  companyId           String          @map("company_id")
  taxYearId           String?         @map("tax_year_id")
  payFrequency        PayFrequency    @default(BI_WEEKLY) @map("pay_frequency")

  // Weekly & Bi-Weekly Anchor Settings
  paydayDayOfWeek     Int             @default(5) @map("payday_day_of_week") // 1=Mon, 5=Fri
  anchorPayDate       String?         @map("anchor_pay_date") // Reference payday (YYYY-MM-DD) for Bi-Weekly parity
  periodLagDays       Int             @default(5) @map("period_lag_days") // Days between period end and payday

  // Semi-Monthly Anchor Settings
  semiMonthlyDay1     Int             @default(15) @map("semi_monthly_day_1") // First pay day (e.g. 15th)
  semiMonthlyDay2     Int             @default(0) @map("semi_monthly_day_2")  // Second pay day (0 = Last day of month)

  // Monthly Anchor Settings
  monthlyPayDay       Int             @default(0) @map("monthly_pay_day")     // Day of month (0 = Last day of month)

  // Cutoff & Weekend Rules
  timesheetCutoffDays Int             @default(2) @map("timesheet_cutoff_days") // Days prior to payday (or after period end)
  weekendRollRule     WeekendRollRule @default(PREVIOUS_BUSINESS_DAY) @map("weekend_roll_rule")

  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  company             Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, taxYearId])
  @@map("pay_schedule_configs")
}

model PayrollCalendarPeriod {
  id                String               @id @default(uuid())
  companyId         String               @map("company_id")
  taxYearId         String               @map("tax_year_id")
  periodNumber      Int                  @map("period_number")
  periodStart       String               @map("period_start") // YYYY-MM-DD
  periodEnd         String               @map("period_end")   // YYYY-MM-DD
  timesheetLockDate String               @map("timesheet_lock_date") // YYYY-MM-DD HH:mm:ss
  scheduledPayDate  String               @map("scheduled_pay_date") // Unadjusted target payday
  actualPayDate     String               @map("actual_pay_date")    // Weekend/Holiday adjusted payday
  status            CalendarPeriodStatus @default(DRAFT)
  publishedAt       DateTime?            @map("published_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxYear           TaxYear              @relation(fields: [taxYearId], references: [id], onDelete: Cascade)
  timesheets        Timesheet[]

  @@unique([companyId, taxYearId, periodNumber])
  @@map("payroll_calendar_periods")
}

model AppStateSnapshot {
  id        String   @id @default("current_state")
  data      Json
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("app_state_snapshots")
}

model EmployeeWorkLocationHistory {
  id                   String    @id @default(uuid())
  employeeId           String    @map("employee_id")
  streetAddress        String?   @map("street_address")
  city                 String?
  state                String
  zip                  String?
  psdCode              String?   @map("psd_code")
  localJurisdictionName String?  @map("local_jurisdiction_name")
  workEitRate          Float?    @map("work_eit_rate")
  allocationPercentage Float     @default(100.0) @map("allocation_percentage")
  effectiveDate        String    @map("effective_date")
  endDate              String?   @map("end_date")
  createdAt            DateTime  @default(now()) @map("created_at")

  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_work_location_histories")
}

model CapitalAsset {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  assetName           String   @map("asset_name")
  category            String
  datePlacedInService String   @map("date_placed_in_service")
  costBasis           Float    @map("cost_basis")
  businessUsePercent  Float    @default(100.0) @map("business_use_percent")
  depreciationMethod  String   @default("MACRS_200_DB") @map("depreciation_method")
  recoveryPeriodYears Float    @default(5.0) @map("recovery_period_years")
  section179Claimed   Float    @default(0.0) @map("section_179_claimed")
  priorDepreciation   Float    @default(0.0) @map("prior_depreciation")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("capital_assets")
}

model HomeOfficeExpense {
  id                   String   @id @default(uuid())
  companyId            String   @map("company_id")
  taxYearId            String   @map("tax_year_id")
  calculationMethod    String   @default("SIMPLIFIED") @map("calculation_method")
  totalHomeSquareFeet  Float    @map("total_home_square_feet")
  officeSquareFeet     Float    @map("office_square_feet")
  mortgageInterest     Float    @default(0.0) @map("mortgage_interest")
  realEstateTaxes      Float    @default(0.0) @map("real_estate_taxes")
  homeInsurance        Float    @default(0.0) @map("home_insurance")
  utilities            Float    @default(0.0) @map("utilities")
  rent                 Float    @default(0.0) @map("rent")
  repairsMaintenance   Float    @default(0.0) @map("repairs_maintenance")
  otherDirectExpenses  Float    @default(0.0) @map("other_direct_expenses")
  otherIndirectExpenses Float   @default(0.0) @map("other_indirect_expenses")
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxYear              TaxYear  @relation(fields: [taxYearId], references: [id], onDelete: Cascade)

  @@unique([companyId, taxYearId])
  @@map("home_office_expenses")
}

model Customer {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  name          String
  contactPerson String?   @map("contact_person")
  email         String
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?   @map("zip_code")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@index([companyId])
  @@map("customers")
}

model Invoice {
  id               String            @id @default(uuid())
  companyId        String            @map("company_id")
  customerId       String            @map("customer_id")
  taxYearId        String            @map("tax_year_id")
  invoiceNumber    String            @map("invoice_number")
  issueDate        String            @map("issue_date")
  dueDate          String            @map("due_date")
  status           String            @default("DRAFT")
  subtotal         Float
  taxAmount        Float             @default(0) @map("tax_amount")
  totalAmount      Float             @map("total_amount")
  amountPaid       Float             @default(0) @map("amount_paid")
  stripePaymentId  String?           @map("stripe_payment_id")
  stripePaymentUrl String?           @map("stripe_payment_url")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  taxYear          TaxYear           @relation(fields: [taxYearId], references: [id], onDelete: Restrict)
  lineItems        InvoiceLineItem[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, taxYearId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @map("unit_price")
  amount      Float

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

model FormW9Record {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  employeeId         String   @unique @map("employee_id")
  businessName       String?  @map("business_name")
  taxClassification  String   @map("tax_classification")
  tinType            String   @map("tin_type")
  tinMasked          String   @map("tin_masked")
  tinEncrypted       String   @map("tin_encrypted")
  exemptPayeeCode    String?  @map("exempt_payee_code")
  fatcaCode          String?  @map("fatca_code")
  address            String
  city               String
  state              String
  zipCode            String   @map("zip_code")
  certifiedSignature String   @map("certified_signature")
  certifiedAt        DateTime @map("certified_at")
  ipAddress          String?  @map("ip_address")
  is1099Eligible     Boolean  @default(true) @map("is_1099_eligible")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("form_w9_records")
}

model ContractorPayment {
  id               String          @id @default(uuid())
  companyId        String          @map("company_id")
  employeeId       String          @map("employee_id")
  taxYearId        String          @map("tax_year_id")
  paymentDate      String          @map("payment_date")
  amount           Float
  paymentMethod    String          @default("ACH") @map("payment_method")
  referenceNumber  String?         @map("reference_number")
  description      String?
  generalExpenseId String?         @unique @map("general_expense_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taxYear          TaxYear         @relation(fields: [taxYearId], references: [id], onDelete: Cascade)
  generalExpense   GeneralExpense? @relation(fields: [generalExpenseId], references: [id], onDelete: SetNull)

  @@index([companyId, taxYearId, employeeId])
  @@map("contractor_payments")
}

model BankImportBatch {
  id              String            @id @default(uuid())
  companyId       String            @map("company_id")
  fileName        String            @map("file_name")
  accountName     String?           @map("account_name")
  accountMask     String?           @map("account_mask")
  totalRows       Int               @map("total_rows")
  matchedCount    Int               @default(0) @map("matched_count")
  reviewCount     Int               @default(0) @map("review_count")
  unmatchedCount  Int               @default(0) @map("unmatched_count")
  duplicateCount  Int               @default(0) @map("duplicate_count")
  netAmount       Float             @map("net_amount")
  importedAt      DateTime          @default(now()) @map("imported_at")

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]

  @@index([companyId])
  @@map("bank_import_batches")
}

model BankTransaction {
  id                   String                    @id @default(uuid())
  companyId            String                    @map("company_id")
  batchId              String                    @map("batch_id")
  fingerprint          String                    @map("fingerprint")
  postedDate           String                    @map("posted_date")
  rawDescription       String                    @map("raw_description")
  cleanPayee           String                    @map("clean_payee")
  amount               Float
  transactionType      String                    @map("transaction_type")
  reconciliationStatus BankReconciliationStatus  @default(NEEDS_REVIEW) @map("reconciliation_status")
  matchedEntityType    BankMatchedEntityType?    @map("matched_entity_type")
  matchedEntityId      String?                   @map("matched_entity_id")
  confidenceScore      Float?                    @map("confidence_score")
  matchNotes           String?                   @map("match_notes")
  reconciledAt         DateTime?                 @map("reconciled_at")
  reconciledBy         String?                   @map("reconciled_by")
  createdAt            DateTime                  @default(now()) @map("created_at")

  company              Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch                BankImportBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([companyId, fingerprint])
  @@index([companyId, reconciliationStatus])
  @@index([companyId, postedDate])
  @@map("bank_transactions")
}


